{
  "version": "1.0",
  "name": "AI Dev Local - Flowise Configuration",
  "description": "Silent setup configuration for Flowise in AI Dev Local environment",
  
  "authentication": {
    "enabled": true,
    "username": "admin",
    "password": "admin123",
    "jwtSecret": "AABBCCDDAABBCCDDAABBCCDDAABBCCDD",
    "jwtRefreshSecret": "AABBCCDDAABBCCDDAABBCCDDAABBCCDDAABBCCDD",
    "tokenExpiryMinutes": 360,
    "refreshTokenExpiryMinutes": 43200
  },
  
  "database": {
    "type": "postgres",
    "host": "postgres",
    "port": 5432,
    "database": "flowise",
    "username": "postgres",
    "password": "postgres",
    "override": true
  },
  
  "server": {
    "port": 3000,
    "corsOrigins": "*",
    "iframeOrigins": "*",
    "numberOfProxies": 1
  },
  
  "features": {
    "showCommunityNodes": true,
    "disableTelemetry": true,
    "langchainTracingV2": false,
    "enableExecutionMode": "main"
  },
  
  "storage": {
    "secretKeyPath": "/root/.flowise",
    "logPath": "/root/.flowise/logs",
    "blobStoragePath": "/root/.flowise/storage",
    "apiKeyPath": "/root/.flowise"
  },
  
  "dependencies": {
    "builtinDependencies": ["crypto", "fs"],
    "externalDependencies": ["moment", "lodash"]
  },
  
  "performance": {
    "chatflowWorkerTimeout": 30000,
    "deployTimeout": 120000,
    "maxUploadSize": "50mb"
  },
  
  "logging": {
    "debug": false,
    "logLevel": "info"
  },
  
  "apiProxy": {
    "enabled": true,
    "openai": {
      "baseUrl": "http://litellm:4000/v1",
      "useEnvKey": true,
      "keyEnvVar": "LITELLM_MASTER_KEY"
    }
  },
  
  "defaults": {
    "chatflows": [],
    "tools": [],
    "credentials": [
      {
        "name": "OpenAI API (via LiteLLM)",
        "credentialName": "openAIApi",
        "description": "OpenAI API routed through LiteLLM proxy for unified access",
        "inputs": {
          "openAIApiKey": "${LITELLM_MASTER_KEY}",
          "basePath": "http://litellm:4000/v1"
        }
      },
      {
        "name": "Anthropic API (via LiteLLM)",
        "credentialName": "anthropicApi", 
        "description": "Anthropic API routed through LiteLLM proxy for unified access",
        "inputs": {
          "anthropicApiKey": "${LITELLM_MASTER_KEY}",
          "basePath": "http://litellm:4000/v1"
        }
      }
    ]
  }
}
