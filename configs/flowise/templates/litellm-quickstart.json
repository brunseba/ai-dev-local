              { "label": "gpt-4-turbo", "name": "gpt-4-turbo" },
              { "label": "gpt-3.5-turbo", "name": "gpt-3.5-turbo" },
              { "label": "claude-3-opus", "name": "claude-3-opus" },
              { "label": "claude-3-sonnet", "name": "claude-3-sonnet" },
              { "label": "claude-3-haiku", "name": "claude-3-haiku" }
            ],
            "default": "gpt-3.5-turbo",
            "optional": true,
            "id": "chatOpenAI_0-input-modelName-options"
          },
          {
            "label": "Temperature",
            "name": "temperature",
            "type": "number",
            "step": 0.1,
            "default": 0.9,
            "optional": true,
            "id": "chatOpenAI_0-input-temperature-number"
          },
          {
            "label": "BasePath",
            "name": "basepath",
            "type": "string",
            "optional": true,
            "placeholder": "http://litellm:4000",
            "id": "chatOpenAI_0-input-basepath-string"
          }
        ],
        "inputAnchors": [
