vector_store_registry:
- vector_store_name: "pgvector-local"
  litellm_params:
    vector_store_id: "default"
    custom_llm_provider: "openai"
    api_base: http://litellm-pgvector:8000/v1
    api_key: os.environ/OPENAI_API_KEY
  vector_store_description: "Local PGVector store for RAG operations"
  vector_store_metadata:
    source: "PostgreSQL with pgvector extension"
    environment: "development"
    endpoint: "http://localhost:8000"
router_settings:
  routing_strategy: usage-based-routing
  model_group_alias:
    gpt-4-group:
    - gpt-4
    - gpt-4-turbo
    claude-group:
    - claude-3-opus
    - claude-3-sonnet
    - claude-3-haiku
    ollama-group:
    - codegemma
    - codellama
    - phi
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  track_cost_per_model: true
  redis_host: os.environ/REDIS_HOST
  redis_port: os.environ/REDIS_PORT
  cache: true
  cache_params:
    type: redis
    ttl: 600
  max_budget: 100
  budget_duration: 30d
  success_callback:
  - langfuse
  failure_callback:
  - langfuse
  langfuse_public_key: os.environ/LANGFUSE_PUBLIC_KEY
  langfuse_secret_key: os.environ/LANGFUSE_SECRET_KEY
  langfuse_host: os.environ/LANGFUSE_HOST
litellm_settings:
  telemetry: false
  json_logs: true
  log_level: INFO
  request_timeout: 600
  max_retries: 3
  ui_access_mode: admin_only
  ui_username: os.environ/UI_USERNAME
  ui_password: os.environ/UI_PASSWORD
